{
  "identifier": "manager-local-only",
  "description": "Grant account management commands strictly to the local manager webview",
  "local": true,
  "windows": ["main", "manager"],
  "webviews": ["manager"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-manager-state",
    "allow-select-provider",
    "allow-add-custom-provider",
    "allow-update-custom-provider",
    "allow-remove-custom-provider",
    "allow-add-account",
    "allow-rename-account",
    "allow-test-account-proxy",
    "allow-copy-account-cookie",
    "allow-remove-account",
    "allow-reorder-accounts",
    "allow-reload-account",
    "allow-clear-account-data",
    "allow-reveal-downloaded-file",
    "allow-switch-account",
    "allow-set-modal-active",
    "allow-open-official-site",
    "allow-resolve-uuid-conflict",
    "allow-dismiss-notice",
    "allow-trigger-quota-sync",
    "allow-update-app-settings",
    "allow-check-for-updates",
    "allow-download-and-install-update",
    "allow-open-external-url"
  ]
}
